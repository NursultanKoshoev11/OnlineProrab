APP_ENV=development
HTTP_ADDR=:8080
# Local development only; staging and production require sslmode=verify-full.
DATABASE_URL=postgres://onlineprorab:onlineprorab@localhost:5432/onlineprorab?sslmode=disable
JWT_SECRET=change-this-secret-before-production
ACCESS_TOKEN_TTL_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Local development uses the filesystem; staging/production require private object storage.
STORAGE_DRIVER=local
# Comma-separated reverse proxy source IPs/CIDRs; required in staging/production.
TRUSTED_PROXY_CIDRS=
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Production storage is Amazon S3. Credentials may come from an AWS workload
# role; on a non-AWS host, provide a dedicated least-privilege IAM access key.
S3_REGION=us-east-1
S3_BUCKET=
S3_DELETION_LEDGER_BUCKET=
S3_BACKUP_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Leave SMS_PROVIDER empty for local development. The fixed dev_code fallback
# additionally requires DEV_SMS_CODE_ENABLED=true and HTTP_ADDR on loopback.
# Staging and production require a configured SMS provider, except staging may
# use one allowlisted test phone with the fixed code below. Never enable these
# values in production or commit the real test phone.
SMS_PROVIDER=
DEV_SMS_CODE_ENABLED=false
STAGING_TEST_SMS_PHONE=
STAGING_TEST_SMS_CODE=
# Optional staging sandbox price override for paid plans; 0 keeps real prices.
STAGING_TEST_PAYMENT_PRICE_KGS=0

# Temporary closed-testing fallback. Configure only on the server, never commit
# the real review phone/code to Git. This accepts REVIEW_SMS_CODE only for
# REVIEW_SMS_PHONE in production; all other numbers still require a real SMS provider.
REVIEW_ONLY_MODE=false
REVIEW_SMS_PHONE=
REVIEW_SMS_CODE=

TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Configure exactly one sender source:
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# O!Dengi / O!Bank online checkout. Keep disabled until merchant test credentials
# are issued. The API password must never be added to source control or a mobile app.
OBANK_ENABLED=false
OBANK_SID=
OBANK_PASSWORD=
OBANK_API_URL=https://mw-api-test.dengi.kg/api/json/json.php
OBANK_API_VERSION=1005
OBANK_TEST=true
OBANK_RESULT_URL=
OBANK_RETURN_URL=https://stroy.com.kg/billing/
# Nikita SMS credentials; production/staging accept only the official HTTPS URL.
NIKITA_API_URL=https://smspro.nikita.kg/api/message
NIKITA_LOGIN=
NIKITA_PASSWORD=
NIKITA_SENDER=
NIKITA_TEST_MODE=false
