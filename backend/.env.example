APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://onlineprorab:onlineprorab@localhost:5432/onlineprorab?sslmode=disable
JWT_SECRET=change-this-secret-before-production
ACCESS_TOKEN_TTL_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Optional S3-compatible storage for local integration testing. Staging and
# production require STORAGE_DRIVER=s3, a private bucket, and HTTPS endpoints.
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=false

# Leave SMS_PROVIDER empty for local development. The fixed dev_code fallback
# additionally requires DEV_SMS_CODE_ENABLED=true and HTTP_ADDR on loopback.
# Staging and production require a configured SMS provider.
SMS_PROVIDER=
DEV_SMS_CODE_ENABLED=false

# Temporary closed-testing fallback. Configure only on the server, never commit
# the real review phone/code to Git. This accepts REVIEW_SMS_CODE only for
# REVIEW_SMS_PHONE in production; all other numbers still require a real SMS provider.
REVIEW_ONLY_MODE=false
REVIEW_SMS_PHONE=
REVIEW_SMS_CODE=

TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Configure exactly one sender source:
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
