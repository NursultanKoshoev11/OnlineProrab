APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://onlineprorab:onlineprorab@localhost:5432/onlineprorab?sslmode=disable
JWT_SECRET=change-this-secret-before-production
ACCESS_TOKEN_TTL_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Leave SMS_PROVIDER empty for local development; the API will return dev_code only outside production.
# Production requires SMS_PROVIDER=twilio and the Twilio settings below.
SMS_PROVIDER=

# Temporary closed-testing fallback. Configure only on the server, never commit
# the real review phone/code to Git. This accepts REVIEW_SMS_CODE only for
# REVIEW_SMS_PHONE; all other numbers still require a real SMS provider.
REVIEW_ONLY_MODE=false
REVIEW_SMS_PHONE=
REVIEW_SMS_CODE=

TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Configure exactly one sender source:
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
