[Unit]
Description=Publish OnlineProrab API host disk and memory metrics
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
Environment=ONLINEPRORAB_ENVIRONMENT=production
Environment=AWS_REGION=eu-north-1
Environment=HOME=/tmp
ExecStart=/usr/local/bin/onlineprorab-host-metrics
TimeoutStartSec=60
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
