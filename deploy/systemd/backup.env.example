# Replace every placeholder before installing this as /etc/onlineprorab/backup.env.
DEPLOY_PATH=/opt/stroy-api
APP_ENV=production
STORAGE_DRIVER=s3
DATABASE_URL=postgres://backup_user:REPLACE_ENCODED_PASSWORD@db.example.com:5432/onlineprorab?sslmode=verify-full
S3_REGION=us-east-1
S3_BUCKET=replace-with-uploads-bucket
S3_DELETION_LEDGER_BUCKET=replace-with-deletion-ledger-bucket
S3_BACKUP_BUCKET=replace-with-backup-archive-bucket
BACKUP_METRIC_NAMESPACE=OnlineProrab/Backups/production
BACKUP_AGE_RECIPIENTS_FILE=/etc/onlineprorab/backup-age-recipients.txt
RETENTION_DAYS=14

# Omit these when the runner uses an IAM role. For a colocated runner, use a
# dedicated IAM user limited to BackupWriterPolicyArn, never the API credentials.
# AWS_ACCESS_KEY_ID=replace-with-dedicated-access-key
# AWS_SECRET_ACCESS_KEY=replace-with-dedicated-secret-key
