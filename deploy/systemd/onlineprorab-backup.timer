[Unit]
Description=Encrypted OnlineProrab backup every six hours

[Timer]
# Every six hours: a lost host loses at most ~6 hours of data until WAL
# archiving (point-in-time recovery) is in place.
OnCalendar=*-*-* 02/6:00:00 UTC
RandomizedDelaySec=15m
Persistent=true
Unit=onlineprorab-backup.service

[Install]
WantedBy=timers.target
