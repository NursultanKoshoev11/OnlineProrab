http://16.171.171.191 {
    handle_path /stroy-site/* {
        reverse_proxy stroy-website:80
    }

    handle {
        reverse_proxy stroy-api:8080
    }
}

api.stroy.com.kg {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Strict-Transport-Security max-age=31536000; includeSubDomains
        Permissions-Policy camera=(), microphone=(), geolocation=()
        -Server
    }

    reverse_proxy stroy-api:8080
}

stroy.com.kg {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Strict-Transport-Security max-age=31536000; includeSubDomains
        Permissions-Policy camera=(), microphone=(), geolocation=()
        -Server
    }

    @stroy_billing path /billing /billing/*
    handle @stroy_billing {
        reverse_proxy stroy-obank-billing:80
    }

    @stroy_staging_api path /staging-api /staging-api/*
    handle @stroy_staging_api {
        uri strip_prefix /staging-api
        reverse_proxy stroy-obank-staging-api:8080
    }

    @stroy_api path /api/v1/* /health /ready
    handle @stroy_api {
        reverse_proxy stroy-api:8080
    }

    handle {
        reverse_proxy stroy-website:80
    }
}

www.stroy.com.kg {
    redir https://stroy.com.kg{uri} permanent
}
